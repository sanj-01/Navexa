{
  "name": "navexa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate-rules",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate-rules": "tsx scripts/validate-rules.ts",
    "test:classify": "tsx scripts/test-classify.ts",
    "eval": "tsx scripts/eval.ts",
    "ingest": "tsx scripts/ingest.ts",
    "tag-attributes": "tsx scripts/tag-attributes.ts",
    "count-chunks": "tsx -e \"import { createClient } from '@supabase/supabase-js'; const sb = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL, process.env.SUPABASE_SERVICE_ROLE_KEY, { auth: { persistSession: false } }); sb.from('chunks').select('*', { count: 'exact', head: true }).then(r => console.log('chunks:', r.count))\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.4",
    "next": "14.2.35",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2"
  }
}
